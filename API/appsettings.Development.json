{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=Ecommerse;Username=postgres;Password=postgres",
    "Redis": "localhost"
  },
  "Token": {
    "Key": "a-very-long-secret-key-for-my-ecommerce-jwt-token-hs512-2026-secure-key-123456789",
    "Issuer": "https://localhost:5001"
  },
  "MediaStorage": {
    "RootPath": "Content/entity-images",
    "RequestPath": "/content/entity-images",
    "MaxFileSize": 10485760,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp",
      "image/gif"
    ]
  },
  "Otp": {
    "HashKey": "development-only-otp-hash-key-change-before-production-2026",
    "ExpiryMinutes": 5,
    "MaxAttempts": 5,
    "CooldownSeconds": 60,
    "MaxRequestsPerWindow": 5,
    "WindowMinutes": 15
  },
  "ApiUrl": "https://localhost:5001/Content/"
