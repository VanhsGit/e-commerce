{
  "name": "client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "start:api": "dotnet watch --project ../API/API.csproj run --urls=https://localhost:5001",
    "start:client": "ng serve --host 0.0.0.0 --port 4200 --poll 1000",
    "dev": "concurrently \"npm run start:api\" \"npm run start:client\"",
    "build": "ng build",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "e2e": "echo \"E2E is deprecated; use Playwright/Cypress or keep the browser-based tests in a separate project.\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.30",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.30",
    "@angular/compiler": "20.3.30",
    "@angular/core": "20.3.30",
    "@angular/forms": "20.3.30",
    "@angular/platform-browser": "20.3.30",
    "@angular/platform-browser-dynamic": "20.3.30",
    "@angular/router": "20.3.30",
    "font-awesome": "^4.7.0",
    "ng-zorro-antd": "20.4.4",
    "ngx-spinner": "^19.0.0",
    "ngx-toastr": "^19.0.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.8.0",
    "uuid": "^11.0.0",
    "xng-breadcrumb": "^15.0.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.35",
    "@angular/cli": "20.3.35",
    "@angular/compiler-cli": "20.3.30",
    "@angular/language-service": "20.3.30",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/jasmine": "~3.5.0",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "^22.15.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "jasmine-core": "~3.10.0",
    "jasmine-spec-reporter": "~4.2.1",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~2.1.0",
    "karma-jasmine": "~3.0.1",
    "karma-jasmine-html-reporter": "^1.4.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "ts-node": "~8.3.0",
    "typescript": "~5.8.0"
  }
